table prix_spot

	column mois
		dataType: dateTime
		formatString: mmm yyyy
		summarizeBy: none
		sourceColumn: mois

	column prix_spot_eur_mwh
		dataType: double
		summarizeBy: sum
		sourceColumn: prix_spot_eur_mwh



	partition prix_spot = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(Dossier & "prix_spot_mensuel.csv"), [Delimiter = ",", Columns = 2, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Entetes = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Types = Table.TransformColumnTypes(Entetes, {{"mois", type date}, {"prix_spot_eur_mwh", type number}}, "en-US")
				in
				    Types
