table charges_fixes

	column mois
		dataType: dateTime
		formatString: mmm yyyy
		summarizeBy: none
		sourceColumn: mois

	column poste
		dataType: string
		summarizeBy: none
		sourceColumn: poste

	column montant
		dataType: double
		summarizeBy: sum
		sourceColumn: montant



	partition charges_fixes = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(Dossier & "charges_fixes.csv"), [Delimiter = ",", Columns = 3, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Entetes = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Types = Table.TransformColumnTypes(Entetes, {{"mois", type date}, {"poste", type text}, {"montant", type number}}, "en-US")
				in
				    Types
